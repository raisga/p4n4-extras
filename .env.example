# ==============================================================================
# Extras Stack Environment Configuration
# ==============================================================================
# Copy this file to .env and customize as needed:
#   cp .env.example .env
# IMPORTANT: Never commit .env — it contains secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# Services
# ------------------------------------------------------------------------------
# Services to run, comma-separated. Every service here is optional and none
# starts by default: list the ones you add (see README.md, "Adding a service").
#   Available: none yet
COMPOSE_PROFILES=

# Restart policy for every container: unless-stopped brings them back after a
# reboot or a Docker restart; "no" leaves them down until the next `p4n4 up`
# (also: always, on-failure). Apply a change with `p4n4 up`.
RESTART_POLICY=unless-stopped

# ------------------------------------------------------------------------------
# General
# ------------------------------------------------------------------------------
TZ=UTC
