# ------------------------------------------------------------------------------
# My Extra: starts when COMPOSE_PROFILES lists my-extra
# ------------------------------------------------------------------------------
# Append this section, renamed, to ../.env.example (the layer has one .env for
# every extra), and add my-extra to its "Available:" list. Every ${VAR} in
# docker-compose.yml needs a line (CI: scripts/check_env_example.py).

# Address and host port its web UI / API is published on. Keep 127.0.0.1 unless
# the network is trusted
MY_EXTRA_BIND=127.0.0.1
MY_EXTRA_PORT=9999
# Generate with: openssl rand -hex 16
MY_EXTRA_PASSWORD=
