# ------------------------------------------------------------------------------
# OBD-II (obd2): starts when COMPOSE_PROFILES lists obd2; obd2-sim is a simulated car
# ------------------------------------------------------------------------------
# Append this section to the extras layer's .env.example, and add obd2, obd2-sim
# to its "Available:" list. Every ${VAR} in docker-compose.yml needs a line
# (CI: scripts/check_env_example.py).

# The adapter. socket://host:port for the simulator or a Wi-Fi adapter (often
# socket://192.168.0.10:35000); a USB adapter's /dev/serial/by-id/… path, mapped in
# the layer's docker-compose.override.yml (copy obd2/override.example.yml)
OBD_DEVICE=socket://p4n4-obd2-sim:35000
# USB only: the group id that owns the device on the host (stat -c %g <device>);
# 20 is dialout on Debian and Raspberry Pi OS
OBD_DEVICE_GID=20
# Device id in the topics (sensors/<id>/rpm, status/<id>/online): one topic level
OBD_DEVICE_ID=car
# Empty: detect them. A USB adapter's serial speed, and the OBD-II protocol
# (1-9, A-C; 6 is CAN 11-bit 500 kbit/s, what most cars since 2008 use)
OBD_BAUDRATE=
OBD_PROTOCOL=
# Reads per second of rpm, speed and MAF (fast) and of the rest (slow); seconds
# between battery voltage and trouble code reads
OBD_POLL_FAST_HZ=5
OBD_POLL_SLOW_HZ=1
OBD_VOLTAGE_INTERVAL=5
OBD_DTC_INTERVAL=30
# Only these measurements, comma-separated (empty: every one the car supports):
# rpm, speed, maf, engine_load, coolant_temp, stft_b1, ltft_b1, intake_temp,
# throttle_pos, fuel_level, battery_v
OBD_PIDS=
# Publish sensors/<id>/raw, the edge runner's feature vector
OBD_RAW=true
# The broker: p4n4-iot's Mosquitto on p4n4-net. MQTT_USER and MQTT_PASSWORD once
# it requires a login (p4n4-iot's MQTT_PASSWORD)
MQTT_HOST=p4n4-mqtt
MQTT_PORT=1883
MQTT_USER=
MQTT_PASSWORD=
# Address and host port of the read-only API. Keep 127.0.0.1 unless the network is
# trusted (a car's hotspot isn't, by default)
OBD2_BIND=127.0.0.1
OBD2_PORT=8090
OBD2_LOG_LEVEL=INFO
# Simulator: a scenario from obd2/simulator/scenarios/ (without .yaml), and close the
# connection every N seconds like a pulled adapter (0: never)
OBD_SIM_SCENARIO=warmup
OBD_SIM_DROP_EVERY=0
