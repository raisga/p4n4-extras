# ==============================================================================
# Extras Stack .gitignore
# ==============================================================================

# Environment files (contain secrets)
.env
.env.local
.env.*.local

# Local compose overrides
docker-compose.override.yml

# Docker volumes (if mounted locally)
data/

# Python
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
.pytest_cache/
dist/
build/
.venv/
venv/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Temporary files
tmp/
temp/
*.tmp
